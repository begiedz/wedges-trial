# Development PostgreSQL connections: same Neon endpoint/branch and database.
# Application prefers POOLED; migrations use UNPOOLED when set, otherwise DATABASE_URL.
DATABASE_URL=
DATABASE_URL_POOLED=
# Optional explicit direct migration override:
# DATABASE_URL_UNPOOLED=

# For pnpm dev:ws, set this in .env.local to the exact browser-facing origin.
# APP_ORIGIN=http://localhost:3000

# Opt-in integration tests only; never use Production. Tests create/drop an isolated schema.
# TEST_DATABASE_URL=

# Leaderboard request budgets per fixed 60-second window (positive integers).
# Public budgets are global across functions; private budgets are per session.
# Operational defaults only: calibrate release traffic under #43.
# LEADERBOARD_SNAPSHOTS_PER_MINUTE=60
# LEADERBOARD_PAGES_PER_MINUTE=600
# LEADERBOARD_ELIGIBILITY_PER_MINUTE=30
# LEADERBOARD_CLAIMS_PER_MINUTE=10
